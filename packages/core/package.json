{
  "name": "@crm/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ids": {
      "types": "./dist/ids/index.d.ts",
      "default": "./dist/ids/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "default": "./dist/money/index.js"
    },
    "./dates": {
      "types": "./dist/dates/index.d.ts",
      "default": "./dist/dates/index.js"
    },
    "./activities": {
      "types": "./dist/activities/index.d.ts",
      "default": "./dist/activities/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "default": "./dist/html/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions/index.d.ts",
      "default": "./dist/permissions/index.js"
    },
    "./fields": {
      "types": "./dist/fields/index.d.ts",
      "default": "./dist/fields/index.js"
    },
    "./objects": {
      "types": "./dist/objects/index.d.ts",
      "default": "./dist/objects/index.js"
    },
    "./sessions": {
      "types": "./dist/sessions/index.d.ts",
      "default": "./dist/sessions/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./file-safety": {
      "types": "./dist/file-safety/index.d.ts",
      "default": "./dist/file-safety/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run src/permissions",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "sanitize-html": "^2.18.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crm/config": "workspace:^",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
