# Every variable a production deployment sets (ADR-0041, docs/RUNBOOK.md).
#
# Copy to `deploy/production.env` and fill it in. That file is never committed. Values here are
# deliberately unusable placeholders: the API and the worker refuse to start if one is left in,
# and print the name of the variable that is wrong (never its value).

# ---- Release ------------------------------------------------------------------------------
CRM_REGISTRY=registry.example.com/acme
CRM_VERSION=0.0.0

# ---- Addresses ----------------------------------------------------------------------------
APP_HOST=app.example.com
API_HOST=api.example.com
WEB_URL=https://app.example.com
API_URL=https://api.example.com

# ---- Secrets: generate each one, do not reuse across environments ---------------------------
# 48 random bytes:   openssl rand -base64 48
# Signs sessions and encrypts MFA secrets. Rotating it signs everyone out and invalidates enrolled
# authenticator secrets (see the runbook before you do).
AUTH_SECRET=

# ---- Database (managed Postgres 16+) -------------------------------------------------------
# One role per job. Never the superuser, never the same password twice. `crm_app` has no BYPASSRLS
# and owns nothing; `crm_migrator` owns the schema and is used only by the migrate job.
DATABASE_URL=postgres://crm_app:GENERATED@db.internal.example.com:5432/crm?sslmode=require
DATABASE_AUTH_URL=postgres://crm_auth:GENERATED@db.internal.example.com:5432/crm?sslmode=require
DATABASE_WORKER_URL=postgres://crm_worker:GENERATED@db.internal.example.com:5432/crm?sslmode=require
DATABASE_ERASURE_URL=postgres://crm_erasure:GENERATED@db.internal.example.com:5432/crm?sslmode=require
DATABASE_MIGRATION_URL=postgres://crm_migrator:GENERATED@db.internal.example.com:5432/crm?sslmode=require
DATABASE_POOL_MAX=10

# ---- Redis (rate limits) --------------------------------------------------------------------
# Every rate limit is counted here so it holds across API instances; without it N instances allow N
# times the limit, so the API refuses to start in production without it. Use rediss:// (TLS) and a
# password. The instance must not evict keys (maxmemory-policy noeviction or volatile-*, never allkeys-*):
# an evicted counter resets a limit. If Redis is unreachable the API keeps limiting per process and logs it.
REDIS_URL=rediss://:GENERATED@redis.internal.example.com:6380
# Only for a deployment that will never run more than one API instance and has no Redis. Starting
# that way logs a warning on every boot.
# RATE_LIMIT_ALLOW_PER_PROCESS=true

# ---- Email (Resend, over REST) --------------------------------------------------------------
# EMAIL_FROM must be on a domain verified in Resend (SPF and DKIM), or mail is not delivered.
EMAIL_FROM=CRM <no-reply@mail.example.com>
RESEND_API_KEY=

# ---- Object storage (S3-compatible) --------------------------------------------------------
S3_BUCKET=
S3_REGION=
# Leave S3_ENDPOINT empty for AWS S3 itself. S3_PUBLIC_ENDPOINT is what a *browser* uploads to
# (presigned URLs) and must be https.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---- Optional -------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info
