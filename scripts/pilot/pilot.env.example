# Environment for the pilot simulation (docs/PILOT_SIMULATION.md). Copy it OUTSIDE the repository, set
# AUTH_SECRET, and pass the copy with --env-file. Everything here is a local development value taken from
# the repository's own .env.example, apart from the database, which is the separate throwaway crm_pilot.
#
# The simulation refuses to run unless every database URL below ends in /crm_pilot.
# Rate limits are raised so the simulation measures the product, not the limiter; the report says what
# the default limits do.

APP_ENV=local
NODE_ENV=development

DATABASE_URL=postgres://crm_app:crm_app_dev@localhost:15432/crm_pilot
DATABASE_AUTH_URL=postgres://crm_auth:crm_auth_dev@localhost:15432/crm_pilot
DATABASE_WORKER_URL=postgres://crm_worker:crm_worker_dev@localhost:15432/crm_pilot
DATABASE_ERASURE_URL=postgres://crm_erasure:crm_erasure_dev@localhost:15432/crm_pilot
DATABASE_MIGRATION_URL=postgres://crm_migrator:crm_migrator_dev@localhost:15432/crm_pilot
DATABASE_POOL_MAX=10

# A separate Redis database number from the one your everyday dev stack uses.
REDIS_URL=redis://localhost:16379/9

API_PORT=3011
API_URL=http://localhost:3011
WEB_URL=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:3011
CORS_ORIGINS=http://localhost:3010

# Make one: openssl rand -base64 48
AUTH_SECRET=replace-me-with-48-random-bytes

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PER_USER=100000
RATE_LIMIT_MAX_PER_TENANT=100000
RATE_LIMIT_MAX_PER_IP=100000
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_PER_IP=100000
AUTH_THROTTLE_MAX_DELAY_MS=1

OUTBOX_POLL_INTERVAL_MS=300
OUTBOX_BATCH_SIZE=50

# Invitation links are read from the API log, so mail is printed there.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@localhost

STORAGE_PROVIDER=s3
S3_BUCKET=crm-files
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:19000
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY_ID=crm_minio
S3_SECRET_ACCESS_KEY=crm_minio_dev_secret
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=info
