{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "tenant:create": "tsx --env-file-if-exists=../../.env src/cli/create-workspace-main.ts",
    "tenant:entitlements": "tsx --env-file-if-exists=../../.env src/cli/entitlements-main.ts",
    "perf:run": "tsx src/perf/load-run-cli.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:security": "vitest run --project security"
  },
  "dependencies": {
    "@better-auth/utils": "0.5.0",
    "@crm/contracts": "workspace:^",
    "@crm/core": "workspace:^",
    "@crm/db": "workspace:^",
    "@crm/env": "workspace:^",
    "@crm/outbound": "workspace:^",
    "@crm/storage": "workspace:^",
    "@fastify/cookie": "^11.1.3",
    "@fastify/csrf-protection": "^8.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@nestjs/common": "12",
    "@nestjs/core": "12",
    "@nestjs/platform-fastify": "12",
    "better-auth": "1.7.10",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crm/config": "workspace:^",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
