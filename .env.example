# Copy to .env for local development. NEVER commit .env (CLAUDE.md §5.8).
# Every value here is a throwaway development placeholder.

NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# The API connects as crm_app: no BYPASSRLS, owns no tables, so RLS always applies.
# Migrations run as crm_migrator, which owns the schema.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://crm_app:crm_app_dev@localhost:15432/crm
DATABASE_MIGRATION_URL=postgres://crm_migrator:crm_migrator_dev@localhost:15432/crm
# The auth layer connects as crm_auth: identity tables only, no business data.
DATABASE_AUTH_URL=postgres://crm_auth:crm_auth_dev@localhost:15432/crm
# The outbox relay connects as crm_worker.
DATABASE_WORKER_URL=postgres://crm_worker:crm_worker_dev@localhost:15432/crm
# The erasure job connects as crm_erasure (ADR-0032). This role can do exactly
# one thing: rewrite the `changes` column of audit rows belonging to a subject
# with an in-flight erasure request. The API never holds these credentials —
# only the worker does — which is the whole point. Leave it unset and erasure
# requests fail with "not configured" rather than erasing a record and silently
# leaving its history readable.
DATABASE_ERASURE_URL=postgres://crm_erasure:crm_erasure_dev@localhost:15432/crm
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis (cache, rate limiting, BullMQ queues)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:16379

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
# Our own public origin. Used to build the Google OAuth redirect URI, which
# Google compares byte for byte against the one registered in its console.
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# 32+ random bytes. Generate: openssl rand -base64 48
AUTH_SECRET=dev-only-insecure-secret-replace-me-with-48-random-bytes
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# Rate limits are applied per tenant AND per user, not just per IP (CLAUDE.md §5.14).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PER_USER=300
RATE_LIMIT_MAX_PER_TENANT=3000

# Sign-in, sign-up, password reset and invitation acceptance have no user to
# key a limit on, so they get their own, much tighter per-IP ceiling
# (CLAUDE.md §5.14).
#
# Note for `pnpm test:e2e`: the Playwright suite signs in dozens of times from
# one address, which a production-sized ceiling rightly refuses on a second run
# inside the window. Raise AUTH_RATE_LIMIT_MAX_PER_IP locally before running it
# repeatedly, or restart the API between runs — the counter is in-process. The
# limit itself has its own test, which sets a deliberately small ceiling.
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_PER_IP=50
# Cap on the progressive delay after repeated failures. Every delayed request
# is a connection held open, so the back-off is bounded rather than doubling
# forever (MVP_SPEC M1).
AUTH_THROTTLE_MAX_DELAY_MS=8000

# ---------------------------------------------------------------------------
# Google sign-in (optional). With these unset the endpoints return 404 rather
# than failing confusingly at the redirect.
# Authorised redirect URI: ${API_URL}/api/v1/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Worker (outbox relay)
# ---------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Object storage (S3-compatible). Presigned URLs only — never stream via the API.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=crm-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Email provider (behind EmailProvider interface).
#   console  prints the message, including verification and reset links
#   memory   keeps messages in memory; used by the test suite
# Both refuse to start when NODE_ENV=production, so a deploy that forgot to
# configure a real provider fails loudly instead of posting reset links into a
# log file.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@localhost
EMAIL_API_KEY=

# ---------------------------------------------------------------------------
# Object storage (import files, generated exports; CLAUDE.md section 5.12)
# `pnpm infra:up` starts MinIO on 19000 (API) and 19001 (console), off the
# default ports. Files move browser <-> store on presigned URLs and never
# through the API, so S3_PUBLIC_ENDPOINT must be an address a *browser* can
# reach. In production on S3 or R2 leave S3_ENDPOINT and S3_PUBLIC_ENDPOINT unset.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=s3
S3_BUCKET=crm-files
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:19000
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY_ID=crm_minio
S3_SECRET_ACCESS_KEY=crm_minio_dev_secret
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
